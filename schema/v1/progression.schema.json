{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/neckscape-navigator/schema/v1/progression.schema.json",
  "title": "NeckScape progression (schema v1)",
  "type": "object",
  "required": ["schema_version", "type", "title", "sections"],
  "allOf": [{ "$ref": "common.schema.json#/$defs/online_fields" }],
  "properties": {
    "schema_version": { "$ref": "common.schema.json#/$defs/version" },
    "type": { "const": "progression" },
    "source": { "$ref": "common.schema.json#/$defs/source" },
    "title": { "type": "string" },
    "attribution": { "type": "string" },
    "key": {
      "type": "object",
      "required": ["tonic"],
      "properties": { "tonic": { "$ref": "common.schema.json#/$defs/note" }, "mode": { "type": "string" } }
    },
    "time_signature": { "$ref": "common.schema.json#/$defs/time_signature" },
    "tempo_bpm": { "$ref": "common.schema.json#/$defs/tempo_bpm" },
    "capo": { "$ref": "common.schema.json#/$defs/capo" },
    "tuning": { "$ref": "common.schema.json#/$defs/tuning" },
    "voicing_style": { "type": "string", "pattern": "^(open|barre|drop2|position_[0-9]{1,2})$" },
    "chords": {
      "type": "object",
      "description": "Chord symbol → voicing. Symbols without one get a voicing chosen by the app.",
      "additionalProperties": {
        "type": "object",
        "required": ["frets"],
        "properties": {
          "frets": {
            "type": "array",
            "description": "Lowest string first; null = muted, 0 = open",
            "items": { "type": ["integer", "null"], "minimum": 0, "maximum": 36 }
          }
        }
      }
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["bars"],
        "properties": {
          "name": { "type": "string" },
          "repeat": { "type": "integer", "minimum": 1, "maximum": 64 },
          "bars": {
            "type": "array",
            "items": { "type": "array", "items": { "type": "string" }, "description": "Chord symbols, split evenly across the bar" }
          }
        }
      }
    }
  }
}
